PORT=3000
DB_PATH=./data/lead-router.db

# Google Sheets — источник строк и приёмник статусов
SHEETS_SPREADSHEET_ID=
# лист, раскладка колонок и значения статусов — в config/columns.json
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
IMPORT_INTERVAL_MS=60000

# Аргус (СРМ)
# База REST API вместе с токеном: .../api/rest/v1/<portal>/<token>
ARGUS_API_URL=
# Куда слать события назначения (если СРМ принимает вебхуки)
ARGUS_WEBHOOK_URL=
ARGUS_WEBHOOK_SECRET=

# Битрикс24 — входящий вебхук для дозагрузки карточек компаний
B24_WEBHOOK_URL=

# Вход в интерфейс. Без этих двух переменных страница открыта всем.
AUTH_USER=
AUTH_PASSWORD=
SESSION_SECRET=               # любая длинная строка; иначе сессии слетают при рестарте
COOKIE_SECURE=1               # 0 для локального http
